{
  "name": "cash-drive",
  "version": "0.1.0",
  "description": "CashDrive SDK and CLI for AI agents",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "bin": { "cash-drive": "./dist/cli.js" },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": { "types": "./dist/index.d.ts", "default": "./dist/index.js" },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./agent": {
      "import": { "types": "./dist/agent.d.ts", "default": "./dist/agent.js" },
      "require": {
        "types": "./dist/agent.d.cts",
        "default": "./dist/agent.cjs"
      }
    },
    "./node": {
      "import": { "types": "./dist/node.d.ts", "default": "./dist/node.js" },
      "require": {
        "types": "./dist/node.d.cts",
        "default": "./dist/node.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "files": ["dist", "README.md"],
  "engines": { "node": ">=20.11.0" },
  "scripts": {
    "build": "tsup && chmod +x dist/cli.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --dir tests/unit",
    "test:e2e": "vitest run --dir tests/e2e",
    "mock": "tsx mock/server.ts",
    "smoke": "node scripts/smoke-esm.mjs && node scripts/smoke-cjs.cjs",
    "lint:pack": "publint && attw --pack .",
    "verify": "npm run typecheck && npm run test && npm run build && npm run smoke && npm run lint:pack",
    "prepublishOnly": "npm run verify"
  },
  "dependencies": {
    "@hiero-ledger/sdk": "2.85.0"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@types/node": "^22.15.0",
    "@vitest/coverage-v8": "^4.1.10",
    "publint": "^0.3.22",
    "tsup": "^8.5.1",
    "tsx": "^4.23.1",
    "typescript": "^5.9.3",
    "vitest": "^4.1.10"
  }
}
